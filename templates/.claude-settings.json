{
  "permissions": {
    "defaultMode": "auto"
  },
  "enabledMcpjsonServers": [
    "carl-mcp"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/carl-hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/design-intent.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/marketing-intent.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/brief-context.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/correction-capture.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{USER_HOME_FWD}}/.claude/hooks/chorus/chorus-prompt.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/deepclaude-pretool.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/design-gate.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "(mcp__Claude_Browser__|mcp__claude-in-chrome__).*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/design-verify-gate.py\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/marketing-gate.py\"",
            "timeout": 10
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      },
      {
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{VAULT_PATH_FWD}}/.agents/skills/gstack/hosts/claude/hooks/question-preference-hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/design-route.py\"",
            "timeout": 35
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/design-telemetry.py\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/design-vision-track.py\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/skill-trigger-telemetry.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/marketing-route.py\"",
            "timeout": 10
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/marketing-telemetry.py\"",
            "timeout": 5
          }
        ],
        "matcher": "Skill"
      },
      {
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{VAULT_PATH_FWD}}/.agents/skills/gstack/hosts/claude/hooks/question-log-hook\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{VAULT_PATH_FWD}}/.agents/skills/gstack/hosts/claude/hooks/auq-error-fallback-hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/session-start-brief.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/design-session-start.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{USER_HOME_FWD}}/.claude/hooks/chorus/chorus-heartbeat.sh\" working",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/design-stop.py\"",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{USER_HOME_FWD}}/.claude/hooks/marketing-stop.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{USER_HOME_FWD}}/.claude/hooks/chorus/chorus-heartbeat.sh\" working",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{USER_HOME_FWD}}/.claude/hooks/chorus/chorus-session-end.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": false,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
